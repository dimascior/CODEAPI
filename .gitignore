# @vscode/test-electron caches its downloaded VS Code build here when the
# runner's cwd is the repo root — measured at 326 MB after an isolated
# extension-host run. The harness belongs outside the repository; this keeps
# an accidental placement out of the working-tree selection.
.vscode-test/
components.js
components.jsx
package.json.d.ts
